      "id": "rappel-lineaire",
      "kind": "formule",
      "front": "Forme générale d’une fonction linéaire ?",
      "back": "$f(x)=ax$."
    },
    {
      "id": "rappel-affine",
      "kind": "formule",
      "front": "Forme générale d’une fonction affine ?",
      "back": "$f(x)=ax+b$."
    },
    {
      "id": "rappel-coefficient",
      "kind": "definition",
      "front": "Dans $f(x)=ax+b$, que représente a ?",
      "back": "Le coefficient directeur de la droite."
    },
    {
      "id": "rappel-origine",
      "kind": "definition",
      "front": "Dans $f(x)=ax+b$, que représente b ?",
      "back": "L’ordonnée à l’origine : $f(0)=b$."
    },
    {
      "id": "rappel-pente",
      "kind": "formule",
      "front": "Coefficient directeur d’une droite passant par A et B ?",
      "back": "$a=\\frac{y_B-y_A}{x_B-x_A}$, avec $x_A\\ne x_B$."
    },
    {
      "id": "rappel-graphique-lineaire",
      "kind": "propriete",
      "front": "Représentation graphique d’une fonction linéaire ?",
      "back": "Une droite passant par l’origine."
    },
    {
      "id": "rappel-hausse",
      "kind": "formule",
      "front": "Coefficient multiplicateur d’une hausse de t % ?",
      "back": "$1+\\frac{t}{100}$."
    },
    {
      "id": "rappel-baisse",
      "kind": "formule",
      "front": "Coefficient multiplicateur d’une baisse de t % ?",
      "back": "$1-\\frac{t}{100}$."
    },
    {
      "id": "rappel-finale",
      "kind": "formule",
      "front": "Valeur finale à partir de la valeur initiale et du coefficient k ?",
      "back": "$V_f=kV_i$."
    },
    {
      "id": "rappel-initiale",
      "kind": "formule",
      "front": "Valeur initiale à partir de la valeur finale et du coefficient k ?",
      "back": "$V_i=\\frac{V_f}{k}$, avec $k\\ne0$."
    },
    {
      "id": "rappel-taux",
      "kind": "formule",
      "front": "Taux d’évolution en pourcentage ?",
      "back": "$t=\\frac{V_f-V_i}{V_i}\\times100$, avec $V_i>0$."
    },
    {
      "id": "rappel-successives",
      "kind": "formule",
      "front": "Coefficient global de deux évolutions successives ?",
      "back": "$k=k_1k_2$."
    }
