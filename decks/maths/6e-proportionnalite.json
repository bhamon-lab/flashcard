    {
      "id": "rappel-definition",
      "kind": "definition",
      "front": "Quand deux grandeurs sont-elles proportionnelles ?",
      "back": "Quand les valeurs de l’une s’obtiennent en multipliant celles de l’autre par un même nombre."
    },
    {
      "id": "rappel-coefficient",
      "kind": "definition",
      "front": "Comment appelle-t-on ce multiplicateur constant ?",
      "back": "Le coefficient de proportionnalité."
    },
    {
      "id": "rappel-unite",
      "kind": "methode",
      "front": "Que signifie « revenir à l’unité » ?",
      "back": "Trouver la valeur pour une unité, puis multiplier par la quantité voulue."
    },
    {
      "id": "rappel-doubler",
      "kind": "propriete",
      "front": "Dans une proportionnalité, que se passe-t-il si une quantité double ?",
      "back": "La quantité correspondante double aussi."
    },
    {
      "id": "rappel-pourcentage",
      "kind": "definition",
      "front": "Que signifie p % ?",
      "back": "p sur 100 : $p\\%=\\frac{p}{100}$."
    },
    {
      "id": "rappel-appliquer",
      "kind": "formule",
      "front": "Calculer p % d’une quantité Q ?",
      "back": "$\\frac{p}{100}\\times Q$."
    },
    {
      "id": "rappel-moitie",
      "kind": "formule",
      "front": "50 % d’une quantité correspond à quelle fraction ?",
      "back": "La moitié : $50\\%=\\frac{1}{2}$."
    },
    {
      "id": "rappel-quart",
      "kind": "formule",
      "front": "25 % d’une quantité correspond à quelle fraction ?",
      "back": "Un quart : $25\\%=\\frac{1}{4}$."
    },
    {
      "id": "rappel-dixieme",
      "kind": "formule",
      "front": "10 % d’une quantité correspond à quelle fraction ?",
      "back": "Un dixième : $10\\%=\\frac{1}{10}$."
    },
    {
      "id": "rappel-proportion",
      "kind": "formule",
      "front": "Exprimer une partie d’un tout en pourcentage ?",
      "back": "$\\frac{\\text{partie}}{\\text{tout}}\\times100$, avec un tout non nul."
    }
