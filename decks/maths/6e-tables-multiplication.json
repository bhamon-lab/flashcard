{
  "id": "math-6e-tables-multiplication",
  "subject": "Maths",
  "title": "Maths · 6e · Tables de multiplication",
  "description": "6e · 2026-2027 · Tables de 0 à 9 en entier, avec les astuces pour les retrouver.",
  "format": "math",
  "color": "#CDEAE0",
  "daily_new_limit": 3,
  "grade": "6e",
  "school_year": "2026-2027",
  "curriculum_reference": "cycle3-2025",
  "cards": [
    {
      "id": "commutativite",
      "kind": "propriete",
      "front": "Peut-on échanger les deux facteurs d’un produit ?",
      "back": "Oui : le produit ne change pas. Par exemple $7\\times8=8\\times7$, il suffit donc d’apprendre la moitié des tables."
    },
    {
      "id": "zero-un",
      "kind": "propriete",
      "front": "Que vaut un produit où un facteur vaut $0$ ? Et où un facteur vaut $1$ ?",
      "back": "Avec $0$, le produit vaut toujours $0$. Avec $1$, le produit reste l’autre facteur : $a\\times1=a$."
    },
    {
      "id": "fois-dix-cent",
      "kind": "methode",
      "front": "Comment multiplier un nombre entier par $10$, par $100$ ?",
      "back": "Par $10$, on ajoute un zéro ; par $100$, on en ajoute deux. Par exemple $7\\times10=70$ et $7\\times100=700$."
    },
    {
      "id": "table-de-cinq",
      "kind": "methode",
      "front": "Comment retrouver rapidement un produit par $5$ ?",
      "back": "Multiplier par $10$ puis prendre la moitié : $8\\times5=80\\div2=40$."
    },
    {
      "id": "table-de-quatre",
      "kind": "methode",
      "front": "Comment retrouver un produit par $4$ ?",
      "back": "Doubler deux fois : $7\\times4=(7\\times2)\\times2=14\\times2=28$."
    },
    {
      "id": "table-de-six",
      "kind": "methode",
      "front": "Comment retrouver un produit par $6$ avec la table de $5$ ?",
      "back": "Ajouter le nombre à son produit par $5$ : $7\\times6=35+7=42$."
    },
    {
      "id": "table-de-sept",
      "kind": "methode",
      "front": "Comment retrouver un produit par $7$ avec les tables de $5$ et de $2$ ?",
      "back": "Additionner le produit par $5$ et le produit par $2$ : $8\\times7=40+16=56$."
    },
    {
      "id": "table-de-neuf",
      "kind": "methode",
      "front": "Comment retrouver un produit par $9$ avec la table de $10$ ?",
      "back": "Multiplier par $10$ puis retirer une fois le nombre : $8\\times9=80-8=72$."
    },
    {
      "id": "table-de-onze",
      "kind": "methode",
      "front": "Comment retrouver un produit par $11$ avec la table de $10$ ?",
      "back": "Multiplier par $10$ puis ajouter une fois le nombre : $9\\times11=90+9=99$."
    },
    {
      "id": "tables-croisees",
      "kind": "methode",
      "front": "Comment calculer $3\\times14$ sans calculatrice ?",
      "back": "Décomposer $14=10+4$ : $3\\times14=3\\times10+3\\times4=30+12=42$."
    },
    {
      "id": "carres-parfaits",
      "kind": "formule",
      "front": "Quels sont les carrés parfaits des tables de $2$ à $10$ ?",
      "back": "$4$ ; $9$ ; $16$ ; $25$ ; $36$ ; $49$ ; $64$ ; $81$ ; $100$."
    },
    {
      "id": "produits-difficiles",
      "kind": "formule",
      "front": "Quels produits de la table de $6$ à $9$ faut-il connaître par cœur ?",
      "back": "$6\\times6=36$ ; $6\\times7=42$ ; $6\\times8=48$ ; $7\\times7=49$ ; $7\\times8=56$ ; $7\\times9=63$ ; $8\\times8=64$ ; $8\\times9=72$ ; $9\\times9=81$."
    },
