      "id": "rappel-signe-meme",
      "kind": "propriete",
      "front": "Signe du produit de deux nombres non nuls de même signe ?",
      "back": "Positif."
    },
    {
      "id": "rappel-signe-different",
      "kind": "propriete",
      "front": "Signe du produit de deux nombres non nuls de signes différents ?",
      "back": "Négatif."
    },
    {
      "id": "rappel-quotient",
      "kind": "propriete",
      "front": "Règle des signes pour un quotient de deux nombres non nuls ?",
      "back": "Même signe : positif. Signes différents : négatif."
    },
    {
      "id": "rappel-inverse",
      "kind": "definition",
      "front": "Inverse d’un nombre non nul a ?",
      "back": "$\\frac{1}{a}$ : son produit par a vaut 1."
    },
    {
      "id": "rappel-inverse-fraction",
      "kind": "formule",
      "front": "Inverse de $\\frac{a}{b}$ ?",
      "back": "$\\frac{b}{a}$, avec $a\\ne0$ et $b\\ne0$."
    },
    {
      "id": "rappel-produit-fractions",
      "kind": "formule",
      "front": "Produit de deux fractions ?",
      "back": "$\\frac{a}{b}\\times\\frac{c}{d}=\\frac{ac}{bd}$, avec $b\\ne0$ et $d\\ne0$."
    },
    {
      "id": "rappel-division-fractions",
      "kind": "formule",
      "front": "Quotient de deux fractions ?",
      "back": "$\\frac{a}{b}\\div\\frac{c}{d}=\\frac{a}{b}\\times\\frac{d}{c}$, avec $b,c,d\\ne0$."
    },
    {
      "id": "rappel-division-regle",
      "kind": "methode",
      "front": "Diviser par un nombre non nul revient à quoi ?",
      "back": "Multiplier par son inverse."
    },
    {
      "id": "rappel-moins-fraction",
      "kind": "formule",
      "front": "Où placer le signe moins d’une fraction ?",
      "back": "$-\\frac{a}{b}=\\frac{-a}{b}=\\frac{a}{-b}$, avec $b\\ne0$."
    },
    {
      "id": "rappel-double-moins",
      "kind": "formule",
      "front": "Deux signes moins dans une fraction ?",
      "back": "$\\frac{-a}{-b}=\\frac{a}{b}$, avec $b\\ne0$."
    }
  ]
