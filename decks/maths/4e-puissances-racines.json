  "cards": [
    {
      "id": "rappel-puissance",
      "kind": "definition",
      "front": "Que signifie $a^n$ pour un entier $n\\geq1$ ?",
      "back": "Le produit de n facteurs égaux à a."
    },
    {
      "id": "rappel-dix-zero",
      "kind": "formule",
      "front": "Valeur de $10^0$ ?",
      "back": "1."
    },
    {
      "id": "rappel-dix-negatif",
      "kind": "formule",
      "front": "Puissance de 10 d’exposant négatif ?",
      "back": "$10^{-n}=\\frac{1}{10^n}$ pour un entier $n>0$."
    },
    {
      "id": "rappel-produit-dix",
      "kind": "formule",
      "front": "Produit de deux puissances de 10 ?",
      "back": "$10^m\\times10^n=10^{m+n}$ pour m et n entiers."
    },
    {
      "id": "rappel-quotient-dix",
      "kind": "formule",
      "front": "Quotient de deux puissances de 10 ?",
      "back": "$\\frac{10^m}{10^n}=10^{m-n}$ pour m et n entiers."
    },
    {
      "id": "rappel-scientifique",
      "kind": "definition",
      "front": "Écriture scientifique d’un nombre strictement positif ?",
      "back": "$a\\times10^n$, avec $1\\leq a<10$ et n entier relatif."
    },
    {
      "id": "rappel-kilo",
      "kind": "formule",
      "front": "Préfixe kilo ?",
      "back": "$10^3$ fois l’unité."
    },
    {
      "id": "rappel-milli",
      "kind": "formule",
      "front": "Préfixe milli ?",
      "back": "$10^{-3}$ fois l’unité."
    },
    {
      "id": "rappel-micro",
      "kind": "formule",
      "front": "Préfixe micro ?",
      "back": "$10^{-6}$ fois l’unité."
    },
    {
      "id": "rappel-racine",
      "kind": "definition",
      "front": "Racine carrée de a, pour $a\\geq0$ ?",
      "back": "Le nombre positif ou nul dont le carré vaut a."
    },
    {
      "id": "rappel-carre-racine",
      "kind": "formule",
      "front": "Carré de la racine carrée de a ?",
      "back": "$(\\sqrt a)^2=a$, pour $a\\geq0$."
    },
    {
      "id": "rappel-encadrer",
      "kind": "methode",
      "front": "Comment encadrer une racine carrée entre deux entiers ?",
      "back": "Encadrer le nombre sous la racine entre deux carrés parfaits consécutifs."
    }
  ]
