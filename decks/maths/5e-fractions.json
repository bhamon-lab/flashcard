  "cards": [
    {
      "id": "rappel-commun",
      "kind": "methode",
      "front": "Première étape pour additionner des fractions de dénominateurs différents ?",
      "back": "Les écrire avec un même dénominateur."
    },
    {
      "id": "rappel-addition",
      "kind": "formule",
      "front": "Somme de deux fractions ?",
      "back": "$\\frac{a}{b}+\\frac{c}{d}=\\frac{ad+bc}{bd}$, avec $b\\ne0$ et $d\\ne0$."
    },
    {
      "id": "rappel-soustraction",
      "kind": "formule",
      "front": "Différence de deux fractions ?",
      "back": "$\\frac{a}{b}-\\frac{c}{d}=\\frac{ad-bc}{bd}$, avec $b\\ne0$ et $d\\ne0$."
    },
    {
      "id": "rappel-comparer",
      "kind": "methode",
      "front": "Comparer deux fractions de dénominateurs positifs différents ?",
      "back": "Les écrire avec le même dénominateur positif, puis comparer les numérateurs."
    },
    {
      "id": "rappel-un",
      "kind": "propriete",
      "front": "Pour a et b positifs, quand $\\frac{a}{b}$ est-elle supérieure à 1 ?",
      "back": "Quand $a>b$."
    },
    {
      "id": "rappel-entier",
      "kind": "formule",
      "front": "Écrire un entier n avec le dénominateur b ?",
      "back": "$n=\\frac{nb}{b}$, avec $b\\ne0$."
    },
    {
      "id": "rappel-complement",
      "kind": "formule",
      "front": "Complément à 1 d’une fraction ?",
      "back": "$1-\\frac{a}{b}=\\frac{b-a}{b}$, avec $b\\ne0$."
    },
    {
      "id": "rappel-nombre-mixte",
      "kind": "formule",
      "front": "Si $a=bq+r$, comment décomposer $\\frac{a}{b}$ ?",
      "back": "$\\frac{a}{b}=q+\\frac{r}{b}$, avec $b>0$ et $0\\leq r<b$."
    }
  ]
}
