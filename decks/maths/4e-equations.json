      "kind": "formule",
      "front": "Développer $k(a+b)$ ?",
      "back": "$ka+kb$."
    },
    {
      "id": "rappel-distributivite-moins",
      "kind": "formule",
      "front": "Développer $k(a-b)$ ?",
      "back": "$ka-kb$."
    },
    {
      "id": "rappel-factoriser",
      "kind": "formule",
      "front": "Factoriser $ka+kb$ ?",
      "back": "$k(a+b)$."
    },
    {
      "id": "rappel-reduire",
      "kind": "formule",
      "front": "Réduire $ax+bx$ ?",
      "back": "$(a+b)x$."
    },
    {
      "id": "rappel-solution",
      "kind": "definition",
      "front": "Solution d’une équation ?",
      "back": "Une valeur de l’inconnue qui rend l’égalité vraie."
    },
    {
      "id": "rappel-addition-membres",
      "kind": "propriete",
      "front": "Ajouter le même nombre aux deux membres d’une équation change-t-il ses solutions ?",
      "back": "Non."
    },
    {
      "id": "rappel-multiplier-membres",
      "kind": "propriete",
      "front": "Par quels nombres peut-on multiplier les deux membres sans changer les solutions ?",
      "back": "Par un même nombre non nul."
    },
    {
      "id": "rappel-ax-b",
      "kind": "formule",
      "front": "Solution de $ax+b=c$, avec $a\\ne0$ ?",
      "back": "$x=\\frac{c-b}{a}$."
    },
    {
      "id": "rappel-deux-membres",
      "kind": "formule",
      "front": "Solution de $ax+b=cx+d$, avec $a\\ne c$ ?",
      "back": "$x=\\frac{d-b}{a-c}$."
    },
    {
      "id": "rappel-verifier",
      "kind": "methode",
      "front": "Comment vérifier une solution ?",
      "back": "Remplacer l’inconnue par cette valeur dans l’équation initiale."
    }
