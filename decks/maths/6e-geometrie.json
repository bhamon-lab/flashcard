      "kind": "definition",
      "front": "Milieu M du segment [AB] ?",
      "back": "$M\\in[AB]$ et $AM=MB$."
    },
    {
      "id": "rappel-cercle",
      "kind": "definition",
      "front": "Cercle de centre O et de rayon r ?",
      "back": "L’ensemble des points M tels que $OM=r$."
    },
    {
      "id": "rappel-disque",
      "kind": "definition",
      "front": "Disque de centre O et de rayon r ?",
      "back": "L’ensemble des points M tels que $OM\\leq r$."
    },
    {
      "id": "rappel-diametre",
      "kind": "formule",
      "front": "Lien entre diamètre d et rayon r ?",
      "back": "$d=2r$."
    },
    {
      "id": "rappel-mediatrice",
      "kind": "definition",
      "front": "Médiatrice d’un segment ?",
      "back": "La droite perpendiculaire au segment passant par son milieu."
    },
    {
      "id": "rappel-equidistance",
      "kind": "propriete",
      "front": "Propriété des points de la médiatrice de [AB] ?",
      "back": "Ils sont à égale distance de A et de B : $MA=MB$."
    },
    {
      "id": "rappel-droit",
      "kind": "definition",
      "front": "Mesure d’un angle droit ?",
      "back": "$90^\\circ$."
    },
    {
      "id": "rappel-plat",
      "kind": "definition",
      "front": "Mesure d’un angle plat ?",
      "back": "$180^\\circ$."
    },
    {
      "id": "rappel-bissectrice",
      "kind": "definition",
      "front": "Bissectrice d’un angle ?",
      "back": "La demi-droite qui partage l’angle en deux angles de même mesure."
    },
    {
      "id": "rappel-triangle",
      "kind": "formule",
      "front": "Somme des angles d’un triangle ?",
      "back": "$180^\\circ$."
    },
    {
      "id": "rappel-isocele",
      "kind": "propriete",
      "front": "Angles à la base d’un triangle isocèle ?",
      "back": "Ils ont la même mesure."
    },
    {
      "id": "rappel-equilateral",
      "kind": "propriete",
      "front": "Angles d’un triangle équilatéral ?",
      "back": "Trois angles de $60^\\circ$."
    },
    {
      "id": "rappel-circonscrit",
      "kind": "propriete",
