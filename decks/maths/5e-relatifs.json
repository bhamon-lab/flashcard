      "id": "rappel-oppose",
      "kind": "definition",
      "front": "Opposé d’un nombre a ?",
      "back": "$-a$. Leur somme vaut zéro : $a+(-a)=0$."
    },
    {
      "id": "rappel-valeur-absolue",
      "kind": "definition",
      "front": "Valeur absolue d’un nombre ?",
      "back": "Sa distance à zéro sur la droite graduée."
    },
    {
      "id": "rappel-comparer",
      "kind": "methode",
      "front": "Comment comparer deux nombres négatifs ?",
      "back": "Le plus grand est celui qui est le plus proche de zéro."
    },
    {
      "id": "rappel-somme-meme-signe",
      "kind": "methode",
      "front": "Additionner deux nombres de même signe ?",
      "back": "Additionner leurs distances à zéro et conserver leur signe."
    },
    {
      "id": "rappel-somme-signes-differents",
      "kind": "methode",
      "front": "Additionner deux nombres de signes différents ?",
      "back": "Soustraire leurs distances à zéro et garder le signe du plus éloigné de zéro. Si les distances sont égales, la somme vaut 0."
    },
    {
      "id": "rappel-soustraction",
      "kind": "formule",
      "front": "Soustraire un nombre b ?",
      "back": "$a-b=a+(-b)$ : ajouter son opposé."
    },
    {
      "id": "rappel-moins-moins",
      "kind": "formule",
      "front": "Soustraire l’opposé de b ?",
      "back": "$a-(-b)=a+b$."
    },
