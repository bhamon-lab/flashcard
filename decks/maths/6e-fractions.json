  "cards": [
    {
      "id": "rappel-quotient",
      "kind": "formule",
      "front": "Que représente $\\frac{a}{b}$, avec $b\\ne0$ ?",
      "back": "Le quotient $a\\div b$ ; $b\\times\\frac{a}{b}=a$."
    },
    {
      "id": "rappel-numerateur",
      "kind": "definition",
      "front": "Quel est le numérateur d’une fraction ?",
      "back": "Le nombre au-dessus de la barre."
    },
    {
      "id": "rappel-denominateur",
      "kind": "definition",
      "front": "Quel est le dénominateur d’une fraction ?",
      "back": "Le nombre sous la barre. Il doit être non nul."
    },
    {
      "id": "rappel-equivalence",
      "kind": "formule",
      "front": "Comment obtenir une fraction égale ?",
      "back": "$\\frac{a}{b}=\\frac{a\\times k}{b\\times k}$, avec $b\\ne0$ et $k\\ne0$."
    },
    {
      "id": "rappel-simplifier",
      "kind": "methode",
      "front": "Comment simplifier une fraction ?",
      "back": "Diviser le numérateur et le dénominateur par un même diviseur non nul."
    },
    {
      "id": "rappel-somme",
      "kind": "formule",
      "front": "Addition de fractions de même dénominateur ?",
      "back": "$\\frac{a}{c}+\\frac{b}{c}=\\frac{a+b}{c}$, avec $c\\ne0$."
    },
    {
      "id": "rappel-difference",
      "kind": "formule",
      "front": "Soustraction de fractions de même dénominateur ?",
      "back": "$\\frac{a}{c}-\\frac{b}{c}=\\frac{a-b}{c}$, avec $c\\ne0$."
    },
    {
      "id": "rappel-entier",
      "kind": "formule",
      "front": "Multiplier une fraction par un entier n ?",
      "back": "$n\\times\\frac{a}{b}=\\frac{na}{b}$, avec $b\\ne0$."
    },
    {
      "id": "rappel-quantite",
      "kind": "formule",
      "front": "Prendre $\\frac{a}{b}$ d’une quantité Q ?",
      "back": "$Q\\times\\frac{a}{b}$, avec $b\\ne0$."
    },
    {
      "id": "rappel-demi",
      "kind": "formule",
      "front": "Un demi en écriture décimale ?",
      "back": "$\\frac{1}{2}=0{,}5$."
    },
    {
      "id": "rappel-quart",
      "kind": "formule",
      "front": "Un quart en écriture décimale ?",
      "back": "$\\frac{1}{4}=0{,}25$."
    },
    {
      "id": "rappel-trois-quarts",
      "kind": "formule",
      "front": "Trois quarts en écriture décimale ?",
      "back": "$\\frac{3}{4}=0{,}75$."
    }
  ]
}
