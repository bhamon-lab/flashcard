      "id": "rappel-coefficient",
      "kind": "formule",
      "front": "Dans $y=kx$, comment retrouver k si $x\\ne0$ ?",
      "back": "$k=\\frac{y}{x}$."
    },
    {
      "id": "rappel-graphique",
      "kind": "propriete",
      "front": "Représentation graphique de données proportionnelles ?",
      "back": "Des points alignés avec l’origine du repère."
    },
    {
      "id": "rappel-echelle",
      "kind": "formule",
      "front": "Formule de l’échelle d’un plan ?",
      "back": "$e=\\frac{\\text{longueur sur le plan}}{\\text{longueur réelle}}$, dans la même unité."
    },
    {
      "id": "rappel-reelle",
      "kind": "formule",
      "front": "Longueur réelle à partir de l’échelle e ?",
      "back": "$\\text{longueur réelle}=\\frac{\\text{longueur sur le plan}}{e}$, avec $e>0$."
    },
    {
      "id": "rappel-plan",
      "kind": "formule",
      "front": "Longueur sur le plan à partir de l’échelle e ?",
      "back": "$\\text{longueur sur le plan}=e\\times\\text{longueur réelle}$, dans la même unité."
    },
    {
      "id": "rappel-pourcentage",
      "kind": "formule",
      "front": "Calculer p % de Q ?",
      "back": "$Q\\times\\frac{p}{100}$."
    },
    {
      "id": "rappel-proportion",
      "kind": "formule",
      "front": "Proportion d’une catégorie dans un ensemble ?",
      "back": "$\\frac{\\text{effectif de la catégorie}}{\\text{effectif total}}$, avec un total non nul."
    },
    {
      "id": "rappel-dependance",
      "kind": "definition",
      "front": "Que signifie « y en fonction de x » ?",
      "back": "La valeur de y dépend de la valeur de x."
    }
  ]
